  "slides": [
    { "bg": "slideMorning.png", "chara": "dialogKibitaro.png", "text": "事件の始まりの日。*600*\n\n\n(スペース/クリックで次へ)" },
    { "bg": "slideBusiness.png", "chara": "dialogOjisan.png", "text": "わしらは村で、おばあさんの作ったきびだんごを売って暮らしておったんじゃ。" },
    { "bg": "slideBusiness.png", "chara": "dialogObaasan.png", "text": "その日も、きびだんごはよく売れたわ" },
    { "bg": "slideEvening.png", "chara": "dialogKibitaro.png", "text": "でも、店を閉めて僕たちが片づけをしていたとき" },
    { "bg": "slideEvening.png", "chara": "dialogKibitaro.png", "text": "家の前で見てしまったの" },
    { "bg": "slideKill0.png", "chara": "dialogObaasan.png", "text": "人が鬼に襲われているところを..." },
    { "bg": "slideKill1.png", "chara": "dialogObaasan.png", "text": "あの日を忘れることはできないわ...毎日夢に出てくるのよ..." },
    { "bg": "slideBlack.png", "chara": "dialogKibitaro.png", "text": "しかもそれから、たびたび襲撃事件が起こるようになったんだ" },
    { "bg": "slideBlack.png", "chara": "dialogKibitaro.png", "text": "このまま放っておけば、また誰かが襲われてしまう" },
    { "bg": "slideBlack.png", "chara": "dialogOjisan.png", "text": "次に狙われるのは、わしらかもしれん" },
    { "bg": "slideBlack.png", "chara": "dialogOjisan.png", "text": "だからこそ、今ここで立ち上がるんじゃ！" },
    { "bg": "backgroundEvening.png", "chara": "dialogKibitaro.png", "text": "...というわけで、僕は村を守るため鬼退治に行くことになったんだ" },
    { "bg": "backgroundEvening.png", "chara": "dialogKibitaro.png", "text": "けど..." },
    { "bg": "backgroundEvening.png", "chara": "dialogObaasan.png", "text": "これ、お供に持っていきなさい。" },
    { "bg": "scenechange.png", "chara": "dialogKibitaro.png", "text": "...これ？" },
    { "bg": "backgroundEvening.png", "chara": "dialogObaasan.png", "text": "きびだんごよ。" },
    { "bg": "backgroundEvening.png", "chara": "dialogKibitaro.png", "text": "...きびだんご..?" },
    { "bg": "backgroundEvening.png", "chara": "dialogObaasan.png", "text": "おじいさんと二人で、昨日作ったの。" },
    { "bg": "backgroundEvening.png", "chara": "dialogOjisan.png", "text": "わしらの自信作じゃ！" },
    { "bg": "backgroundEvening.png", "chara": "dialogKibitaro.png", "text": "..." },
    { "bg": "backgroundEvening.png", "chara": "dialogKibitaro.png", "text": "これ、僕が運ぶの？" },
    { "bg": "backgroundEvening.png", "chara": "dialogObaasan.png", "text": "もちろん。" },
    { "bg": "backgroundEvening.png", "chara": "dialogKibitaro.png", "text": "......。" },
    { "bg": "backgroundEvening.png", "chara": "dialogKibitaro.png", "text": "こっちのほうが鬼より大変じ", "fastauto": true },
    { "bg": "backgroundEvening.png", "chara": "dialogObaasan.png", "text": "それと、一つだけ大事なことがあるの。" },
    { "bg": "backgroundEvening.png", "chara": "dialogObaasan.png", "text": "このきびだんごは、鬼種族の中で一番強い鬼と戦うときまで食べちゃダメよ。" },
    { "bg": "backgroundEvening.png", "chara": "dialogKibitaro.png", "text": "一番強い鬼と戦うときだけ...？" },
    { "bg": "backgroundEvening.png", "chara": "dialogObaasan.png", "text": "そう。私が言うまで、絶対に食べないこと。" },
    { "bg": "backgroundEvening.png", "chara": "dialogKibitaro.png", "text": "わ、分かった...。" },
    { "bg": "backgroundEvening.png", "chara": "dialogOjisan.png", "text": "では、気をつけて行ってくるんじゃぞ！" },
    { "bg": "backgroundEvening.png", "chara": "dialogKibitaro.png", "text": "...ありがとう。" },
    { "bg": "backgroundEvening.png", "chara": "dialogKibitaro.png", "text": "じゃあ行ってくるよ。" },
    { "bg": "backgroundEvening.png", "chara": null, "text": "こうして僕は、鬼退治の旅へ出発した。" }
  ]
