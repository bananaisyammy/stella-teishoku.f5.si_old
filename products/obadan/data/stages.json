[
    {
        "name": "ステージ1 - 旅立ちの朝",
        "timeLimit": 300,
        "chunks": [
            {
                "enemies": [],
                "events": [
                    {
                        "type": "dialog",
                        "triggerX": 0,
                        "chara": "dialogOjisan.png",
                        "text": "「おーい、きび太郎や。ついに出発の日じゃな。」"
                    },
                    {
                        "type": "dialog",
                        "triggerX": 100,
                        "chara": "dialogOjisan.png",
                        "text": "「まずは基本の操作を思い出すんじゃ。*600*Dキーか右矢印キーで前進、Aキーか左矢印キーで後退できるぞ。」"
                    },
                    {
                        "type": "dialog",
                        "triggerX": 300,
                        "chara": "dialogOjisan.png",
                        "text": "「マウスで狙いを定めて左クリック、あるいはFキーで、きびだんごを発射できるわい。」"
                    },
                    {
                        "type": "dialog",
                        "triggerX": 600,
                        "chara": "dialogOjisan.png",
                        "text": "「Shiftキーを押しながら移動すればダッシュもできるぞ。*600*道中、気をつけて行くのじゃぞ。」"
                    }
                ]
            },
